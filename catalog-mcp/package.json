{
  "name": "@helpfulmods/catalog-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run build && npm test",
    "start": "node dist/stdio.js",
    "serve": "node dist/node.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "description": "Public Helpful Mods catalog MCP component and HTTP handler.",
  "overrides": {
    "hono": "4.13.16"
  }
}
